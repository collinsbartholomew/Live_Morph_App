# Keep the build context (and thus the image) free of secrets, build output,
# and local state. The Dockerfile only needs Cargo.toml/Cargo.lock + src.
target/
.env
.env.*
!.env.example
!.env.production.template
.test.env
tests/
scripts/
docs/
*.log
*.md
# rust-toolchain.toml is intentionally NOT ignored: the pinned toolchain must
# travel with the build context so the image builds with the same rustc.
