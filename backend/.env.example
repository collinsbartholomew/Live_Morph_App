# =============================================================================
# LiveMorph Backend — Environment Configuration
# Copy to `.env` and fill in values. Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Bind address for the HTTP + WebSocket API (Qt clients connect here)
HOST=127.0.0.1
# TCP port (Qt BackendClient defaults to 3874)
PORT=3874
# Public base URL used in magic-link emails / deep links (no trailing slash)
PUBLIC_BASE_URL=http://127.0.0.1:3874
# RUST_LOG filter (e.g. info,livemorph_backend=debug)
RUST_LOG=info,livemorph_backend=debug,actix_web=info

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
# Full connection string. Local example: mongodb://127.0.0.1:27017
# Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name
MONGODB_DB=livemorph
# Isolated DB for Live Escape product data (users, keys, LE orders)
MONGODB_DB_LIVEESCAPE=liveescape

# -----------------------------------------------------------------------------
# Auth (all handled in this backend — no Supabase / Auth0 / Firebase)
# -----------------------------------------------------------------------------
# HS256 secret for access + refresh JWTs (min 32 random bytes, base64 or hex string)
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Access token lifetime in seconds (default 15 minutes)
JWT_ACCESS_TTL_SECS=900
# Refresh token lifetime in seconds (default 30 days)
JWT_REFRESH_TTL_SECS=2592000

# -----------------------------------------------------------------------------
# Google OAuth (optional — "Continue with Google" on Auth screen)
# -----------------------------------------------------------------------------
# Create OAuth 2.0 Client (Desktop or Web) in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match authorized redirect URI exactly, e.g.:
#   http://127.0.0.1:3874/api/v1/auth/oauth/google/callback
GOOGLE_REDIRECT_URI=

# Magic-link / OTP code length (6–8)
OTP_LENGTH=8
# OTP validity window in seconds
OTP_TTL_SECS=600
# Max failed OTP / login attempts before temporary lockout
AUTH_MAX_ATTEMPTS=5
# Lockout duration in seconds after AUTH_MAX_ATTEMPTS
AUTH_LOCKOUT_SECS=60
# Issuer claim embedded in JWTs
JWT_ISSUER=livemorph

# -----------------------------------------------------------------------------
# Credits & billing (internal ledger — no Stripe/Paystack required for core flow)
# -----------------------------------------------------------------------------
# Credits deducted per second of active Decart generation (float ok)
CREDITS_PER_SECOND=2.0
# Free starter credits granted on new account signup
SIGNUP_BONUS_CREDITS=100
# Minimum balance required to start a morph session
MIN_CREDITS_TO_START=5.0
# HD tier multiplier applied on top of CREDITS_PER_SECOND when swap_tier=hd
HD_CREDIT_MULTIPLIER=1.5

# -----------------------------------------------------------------------------
# Decart (ONLY third-party service allowed)
# -----------------------------------------------------------------------------
# Platform API key from https://platform.decart.ai — NEVER expose to the Qt client
DECART_API_KEY=your-decart-platform-api-key
# Upstream signaling base (official)
DECART_SIGNALING_URL=wss://api3.decart.ai/v1/stream
# Default realtime model id (lucy-2.1 | lucy-2.5 | lucy-restyle-2 | …)
DECART_DEFAULT_MODEL=lucy-2.1
# Optional: comma-separated allow-list of model ids clients may request
DECART_ALLOWED_MODELS=lucy-2.1,lucy-2.5,lucy-restyle-2

# -----------------------------------------------------------------------------
# Stream / OBS helpers (local MJPEG metadata only — frames stay client-side)
# -----------------------------------------------------------------------------
# Default port advertised to Qt for OBS Browser Source URL construction
STREAM_DEFAULT_PORT=4789

# -----------------------------------------------------------------------------
# Catalog
# -----------------------------------------------------------------------------
# If true, seed starter characters into Mongo on first boot when collection empty
SEED_STARTER_CATALOG=true


# -----------------------------------------------------------------------------
# Payments — Paystack (money settles in YOUR merchant account)
# -----------------------------------------------------------------------------
# From https://dashboard.paystack.com/#/settings/developer
# Secret key stays on the server only — never ship to Qt
PAYSTACK_SECRET_KEY=sk_live_or_test_xxx
# Optional: expose public key to Qt for inline JS if ever needed
PAYSTACK_PUBLIC_KEY=pk_live_or_test_xxx
# Optional callback after hosted checkout (desktop usually uses verify poll)
# Browser return after hosted checkout (user's browser, not Paystack servers):
# Local:  http://127.0.0.1:3874/api/v1/payments/callback/paystack
# Public: https://YOUR_HOST/api/v1/payments/callback/paystack
PAYSTACK_CALLBACK_URL=http://127.0.0.1:3874/api/v1/payments/callback/paystack
# Webhook (Paystack servers → your API) — set in Dashboard → Settings → API Keys & Webhooks:
# https://YOUR_PUBLIC_HOST/api/v1/payments/webhook/paystack
# PAYSTACK_CALLBACK_URL_LEGACY=https://your-app.example/payments/callback
# Charge currency for Paystack (NGN is the primary Paystack market)
PAYSTACK_CURRENCY=NGN


# -----------------------------------------------------------------------------
# Crypto payments — NOWPayments (USDT and other coins)
# -----------------------------------------------------------------------------
# API key from https://account.nowpayments.io
NOWPAYMENTS_API_KEY=
# Optional IPN callback (server webhook for finished payments)
NOWPAYMENTS_IPN_CALLBACK_URL=
# IPN HMAC secret (NOWPayments dashboard) — required in production
NOWPAYMENTS_IPN_SECRET=
# Default invoice currency (usdttrc20 recommended for low fees)
NOWPAYMENTS_DEFAULT_PAY_CURRENCY=usdttrc20

# Token economics (platform credits the user receives after payment)
# Packs are defined in code (TokenPackage::catalog). Usage: CREDITS_PER_SECOND
# is debited on each Decart generation_tick until balance hits 0 → session ends.


# -----------------------------------------------------------------------------
# Production safety (READ BEFORE GOING LIVE)
# -----------------------------------------------------------------------------
# development | production
RUST_ENV=development
# Comma-separated browser origins. Empty in production = no CORS (desktop-only API)
CORS_ORIGINS=
# MUST be false in production
ALLOW_MANUAL_PAYMENTS=false
ALLOW_CREDITS_ADJUST=false
# MUST be false in production (never log OTP codes for real users)
LOG_OTP_CODES=false
# Max JSON body (bytes) — protects set_image / large prompts
MAX_BODY_BYTES=8388608
# Prefer same as PAYSTACK_SECRET_KEY for webhook HMAC-SHA512
PAYSTACK_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# SMTP — OTP delivery (required for production magic-link)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=LiveMorph <noreply@yourdomain.com>
# true for port 587 STARTTLS; false for implicit TLS (465) depending on provider
SMTP_STARTTLS=true


# -----------------------------------------------------------------------------
# WebRTC ICE servers (JSON) for Qt clients
# -----------------------------------------------------------------------------
ICE_SERVERS_JSON=

MAX_CONCURRENT_SESSIONS=1


# -----------------------------------------------------------------------------
# Decart economics (platform pays Decart from merchant revenue)
# -----------------------------------------------------------------------------
# User pays Paystack in full → you receive money → backend funds internal
# Decart budget = payment_usd * (1 - PLATFORM_MARGIN_RATIO)
# Morph burns budget at DECART_USD_PER_SECOND while debitting user CREDITS_PER_SECOND
DECART_USD_PER_SECOND=0.02
PLATFORM_MARGIN_RATIO=0.35

# Live Escape
ADMIN_SECRET=
USD_NGN_RATE=1600
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=


# -----------------------------------------------------------------------------
# Platform bootstrap / ops
# -----------------------------------------------------------------------------
# Bump to force all clients to refetch GET /api/v1/bootstrap
CONFIG_REVISION=1.8.0
SUPPORT_EMAIL=support@yourdomain.com
APP_LATEST_VERSION=1.8.0
APP_FORCE_UPDATE=false
APP_DOWNLOAD_URL=
APP_UPDATE_NOTES=

# Operator maintenance / announcement / downloads (LiveEscape + LiveMorph)
# Set APP_MAINTENANCE=1 to show the full-screen maintenance gate.
APP_MAINTENANCE=
# One-shot dashboard announcement (title + message) served to clients.
DASHBOARD_NOTIFICATION_TITLE=
DASHBOARD_NOTIFICATION_MESSAGE=
# Comma-separated video/download URLs for the in-app tutorials/downloads list.
DOWNLOAD_URLS=
# Force streaming unavailable (e.g. maintenance of the Decart pipeline).
STREAMING_UNAVAILABLE=

# Production must set:
# RUST_ENV=production
# JWT_SECRET=<32+ random>
# DECART_API_KEY=
# PUBLIC_BASE_URL=https://api.yourdomain.com
# ALLOW_MANUAL_PAYMENTS=false
# ALLOW_CREDITS_ADJUST=false
# LOG_OTP_CODES=false
# CORS_ORIGINS=  (empty = deny browser CORS; desktop apps OK)
