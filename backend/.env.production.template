# LiveMorph Platform — production template (copy to .env and fill)
# Dual product: LiveMorph + Live Escape | Actix host
# NEVER commit real secrets to version control.

RUST_ENV=production
HOST=127.0.0.1
PORT=3874
PUBLIC_BASE_URL=https://api.yourdomain.com

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=livemorph
MONGODB_DB_LIVEESCAPE=liveescape

JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_ISSUER=livemorph
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=2592000

DECART_API_KEY=REPLACE_WITH_DECART_API_KEY
DECART_SIGNALING_URL=wss://api3.decart.ai/v1/stream
DECART_DEFAULT_MODEL=lucy-2.5
DECART_ALLOWED_MODELS=lucy-2.1,lucy-2.5,lucy-restyle-2

CREDITS_PER_SECOND=2
MIN_CREDITS_TO_START=1
SIGNUP_BONUS_CREDITS=0
SEED_STARTER_CATALOG=true

PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_PAYSTACK_SECRET
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_WITH_PAYSTACK_PUBLIC
PAYSTACK_CURRENCY=NGN
PAYSTACK_CALLBACK_URL=https://api.yourdomain.com/api/v1/payments/callback/paystack
PAYSTACK_WEBHOOK_SECRET=REPLACE_WITH_PAYSTACK_WEBHOOK_SECRET

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_DEFAULT_PAY_CURRENCY=usdttrc20

ALLOW_MANUAL_PAYMENTS=false
ALLOW_CREDITS_ADJUST=false
LOG_OTP_CODES=false

SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=noreply@yourdomain.com
SMTP_STARTTLS=true

GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/v1/auth/oauth/google/callback

USD_NGN_RATE=1600
ADMIN_SECRET=REPLACE_WITH_ADMIN_SECRET_MIN_32_CHARS
FLUTTERWAVE_SECRET_KEY=REPLACE_WITH_FLUTTERWAVE_SECRET
FLUTTERWAVE_PUBLIC_KEY=REPLACE_WITH_FLUTTERWAVE_PUBLIC

CORS_ORIGINS=
MAX_BODY_BYTES=8388608
MAX_CONCURRENT_SESSIONS=1

CONFIG_REVISION=1.8.0
SUPPORT_EMAIL=support@yourdomain.com
APP_LATEST_VERSION=1.8.0
APP_FORCE_UPDATE=false
APP_DOWNLOAD_URL=
APP_UPDATE_NOTES=
